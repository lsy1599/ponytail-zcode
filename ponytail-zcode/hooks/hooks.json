{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/zcode-session-start.js"],
            "timeoutMs": 8000,
            "statusMessage": "PONYTAIL: loading rules..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/zcode-prompt.js"],
            "timeoutMs": 8000
          }
        ]
      }
    ]
  }
}
